<?xml version="1.0" encoding="UTF-8"?>
<!--
  TigerCodeSnippets PHPUnit config — a single `unit` suite (no DB, no network): the pure global
  helper functions shipped in snippets/ (slug, human_bytes, time_ago, array_get, initials, ordinal).

  Dependencies (Tiger_*/Zend_* via tigerzf, PHPUnit) resolve from a sibling tiger-core checkout's
  vendor/ (or $TIGER_CORE_VENDOR) — this module has no runtime vendor of its own. Run with that
  checkout's phpunit:
    ../tiger-core/vendor/bin/phpunit
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerErrors="true">

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">snippets</directory>
        </include>
    </source>

    <php>
        <env name="APPLICATION_ENV" value="testing"/>
    </php>
</phpunit>
